# Authlete service credentials — from the console at https://us.authlete.com
AUTHLETE_BASE_URL=https://us.authlete.com
AUTHLETE_SERVICE_ID=
AUTHLETE_API_TOKEN=

# This server's public URL (its issuer identity).
AS_BASE_URL=http://localhost:3000

# Where auth-ui runs — its identity and JWKS derive from this URL.
AUTH_UI_URL=http://localhost:3001

# Private ES256 key for signing interaction JWTs to auth-ui.
# Generate one:  npm run keygen
AS_SIGNING_JWKS=

# Listen port for `npm run dev` / `npm start`.
PORT=3000

# Browser origins allowed to call the OAuth endpoints, comma-separated
# (e.g. http://localhost:5173 for the OAuth Playground). Empty = CORS off.
CORS_ORIGINS=
