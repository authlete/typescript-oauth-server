# Authlete cluster + service credentials
AUTHLETE_BASE_URL=https://us.authlete.com
AUTHLETE_SERVICE_ID=
AUTHLETE_API_TOKEN=

# This AS's public origin (its identity, and the URL RPs use to reach it).
AS_BASE_URL=http://localhost:3000

# The auth-ui peer's base URL — its identity and JWKS (/.well-known/jwks.json)
# derive from this. See INTERACTION_PROTOCOL.md §1.
AUTH_UI_URL=http://localhost:3001

# The AS's private JWKS for signing interaction JWTs to auth-ui (published at
# /.well-known/jwks.json). Generate an ES256 keypair: {"keys":[<jwk-with-d>]}
AS_SIGNING_JWKS=

# Server
PORT=3000
NODE_ENV=development

# CORS allowlist for the OAuth endpoints (comma-separated origins). Needed when
# browser clients like the OAuth Playground call this AS. "*" = any (dev only);
# empty = disabled.
CORS_ORIGINS=http://localhost:5173,https://authlete-playground.vercel.app
