# Authlete service credentials — from the console at https://us.authlete.com
AUTHLETE_BASE_URL=https://us.authlete.com
AUTHLETE_SERVICE_ID=
AUTHLETE_API_TOKEN=

# This server's public URL (its issuer identity).
AS_BASE_URL=http://localhost:3000

# Where auth-ui runs — its identity and JWKS derive from this URL.
AUTH_UI_URL=http://localhost:3001

# Private ES256 key for signing interaction JWTs to auth-ui.
# Generate one:  npm run keygen
AS_SIGNING_JWKS=

# Optional second interaction UI dedicated to consent. Unset → auth-ui handles
# both authentication and consent. Set to a consent UI's URL → auth-ui
# authenticates and that UI handles consent (regulated RAR / Grant Management).
CONSENT_UI_URL=

# Enables the per-grant revoke proxy to Authlete's first-party Grant API. Off by
# default — a stock Authlete doesn't ship it, so leave false unless running the
# spike-enabled Authlete (local). When off, the consent panel falls back to
# client-level revocation.
GRANT_API_ENABLED=false

# Listen port for `npm run dev` / `npm start`.
PORT=3000

# Browser origins allowed to call the OAuth endpoints, comma-separated.
# Prefilled with the Authlete OAuth Playground (hosted + local). Empty = CORS off.
CORS_ORIGINS=https://authlete-playground.vercel.app,http://localhost:5173
